{
  "name": "bgf-site",
  "version": "1.0.0",
  "private": true,
  "description": "Boden GameFest 2027 interest survey - Flask + SQLite in Docker",
  "scripts": {
    "dev": "docker compose up --build",
    "build": "docker compose build",
    "start": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "pdf": "docker compose run --rm bgf-site python generate_pdf.py",
    "css": "tailwindcss -i tailwind.input.css -o static/tailwind.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
